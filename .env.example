# ---- PaperLens v1 (MVP) configuration ----
# Copy to .env and fill in values. All paths are inside the container by default.

# Generation model (M8). Default per spec is GPT-4o, configurable via env var.
OPENAI_API_KEY=sk-your-key-here
PAPERLENS_LLM_MODEL=gpt-4o

# Locked v1 models. Override only for testing.
PAPERLENS_EMBEDDING_MODEL=BAAI/bge-m3
PAPERLENS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Embedding backend: "bge" (real model) or "hash" (deterministic, offline — tests/CI).
PAPERLENS_EMBEDDING_BACKEND=bge

# Reproducibility (NFR: fixed seeds).
PAPERLENS_SEED=42

# Storage. Mounted as a volume by docker-compose.
PAPERLENS_DATA_DIR=/data

# Retrieval/QA tuning (locked defaults follow the spec).
PAPERLENS_RETRIEVE_TOP_K=20
PAPERLENS_RERANK_TOP_K=5
PAPERLENS_CHUNK_MIN_TOKENS=100
PAPERLENS_CHUNK_MAX_TOKENS=600

# Backend URL used by the Streamlit frontend.
PAPERLENS_API_URL=http://localhost:8000
